#!/usr/bin/env bash

set -euo pipefail

PROGRAM="${0##*/}"
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

usage() {
  printf '%s\n' \
    'Usage: dots <command>' \
    '' \
    'Keep the dotfiles checkout stowed into the home directory.' \
    '' \
    'Commands:' \
    '  sync    Restow the packages for this machine' \
    '  check   Preview the restow and report conflicts without changing anything' \
    '  help    Show this help menu'
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

machine_packages() {
  printf '%s\n' dev
  case "$(uname -s)" in
    Darwin) printf '%s\n' dev-macos desktop-macos ;;
    Linux) printf '%s\n' dev-linux desktop-linux ;;
    *) die "unsupported OS: $(uname -s)" ;;
  esac
}

dots_sync() {
  local packages
  require_command stow
  packages=($(machine_packages))
  stow --restow -d "$DOTFILES_DIR" -t "$HOME" "${packages[@]}"
  printf 'Synced %s.\n' "${packages[*]}"
  printf 'Reload the current shell to pick up startup changes: exec zsh\n'
}

dots_check() {
  local packages
  require_command stow
  packages=($(machine_packages))
  stow --no --restow -d "$DOTFILES_DIR" -t "$HOME" "${packages[@]}" ||
    die "stow reported conflicts"
  printf 'Dotfiles can be stowed cleanly.\n'
}

command_name="${1:-help}"
case "$command_name" in
  help | -h | --help)
    usage
    ;;
  sync)
    [[ $# -eq 1 ]] || die "usage: dots sync"
    dots_sync
    ;;
  check)
    [[ $# -eq 1 ]] || die "usage: dots check"
    dots_check
    ;;
  *)
    die "unknown command: $command_name (run '$PROGRAM help')"
    ;;
esac
